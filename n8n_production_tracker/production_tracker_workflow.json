      "id": "261ca966-424d-5feb-821a-49ef7aacf78e",
      "name": "Read Tracker",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        260
      ],
      "executeOnce": true,
      "alwaysOutputData": true
