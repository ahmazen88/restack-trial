# Fully offline: local models via Ollama (OpenAI-compatible API). No API key.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cap generated tokens per reply to keep CPU latency down (raise if you need
# longer answers). Keeping models resident is handled by OLLAMA_KEEP_ALIVE.
OLLAMA_MAX_TOKENS=512

# Optional: point the knowledge base at a different local folder.
# KNOWLEDGE_DIR=/absolute/path/to/your/files
