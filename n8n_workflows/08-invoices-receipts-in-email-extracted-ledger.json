      ],
      "webhookId": "40df8612-0771-4903-bae8-f472f4d3ed47"
    },
    {
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $json._messageId }}",
        "labelIds": "={{ [$('Config').first().json.processedLabelId] }}"
      },
      "id": "209e492e-d23c-4641-b98b-6feef3209487",
      "name": "Label Processed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
