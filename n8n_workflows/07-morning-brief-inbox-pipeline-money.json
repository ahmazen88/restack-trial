      "id": "860ee2d0-1345-4e40-95a5-a86c7c470e65",
      "name": "Last 24h Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(m => m.id).map(m => {\n  const f = m.from?.value?.[0] || {};\n  const unread = (m.labelIds || []).includes('UNREAD');\n  const text = String(m.text || m.snippet || '').replace(/\\s+/g, ' ').slice(0, 350);\n  return `${unread ? '[UNREAD] ' : ''}${f.name || ''} <${f.address || ''}> | ${m.subject || ''} | ${text}`;\n});\nreturn [{ json: { emailCount: rows.length, emails: rows.join('\\n') || '(no new email)' } }];"
      },
      "id": "e51b6df6-5406-424d-9a21-65ac5bffbaba",
      "name": "Compact Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      },
      "id": "d0ff9b51-2ef5-4b9c-98c5-ba6dbfc9d5be",
      "name": "Read Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "options": {}
      },
      "id": "3869121c-ce10-4057-99e4-a70490035093",
      "name": "Read Invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1100,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().slice(0, 10);\nconst leads = $('Read Leads').all().map(i => i.json).filter(l => l.email);\nconst due = leads.filter(l => l.next_follow_up && String(l.next_follow_up).slice(0, 10) <= today && !['won', 'lost', 'replied', 'nurture'].includes(l.stage));\nconst hot = leads.filter(l => l.tier === 'hot' && !['won', 'lost', 'meeting_booked'].includes(l.stage));\nconst replied = leads.filter(l => l.stage === 'replied');\nconst inv = $('Read Invoices').all().map(i => i.json).filter(r => r.invoice_id && !['paid', 'void'].includes(String(r.status).toLowerCase()));\nconst overdue = inv.filter(r => String(r.due_date).slice(0, 10) < today);\nconst sum = a => a.reduce((s, r) => s + (Number(r.amount) || 0), 0);\nconst L = l => `${l.name} (${l.company || l.email}) — ${l.tier || ''} ${l.score || ''} — ${l.intent || ''} — stage ${l.stage}`;\nreturn [{ json: {\n  emails: $('Compact Emails').first().json.emails,\n  followUpsDue: due.map(L).join('\\n') || 'none',\n  hotLeads: hot.map(L).join('\\n') || 'none',\n  repliedLeads: replied.map(L).join('\\n') || 'none',\n  overdue: overdue.map(r => `${r.invoice_id} ${r.client_name} ${r.amount} ${r.currency || ''} due ${r.due_date}`).join('\\n') || 'none',\n  outstandingTotal: sum(inv), overdueTotal: sum(overdue),\n  dateLabel: new Date().toDateString(),\n}}];"
      },
      "id": "7d8c28ec-ba4c-4367-8a33-5178ff3a80db",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today: {{ $json.dateLabel }}\nMy priorities: {{ $('Config').first().json.priorities }}\n\nINBOX (last 24h)\n{{ $json.emails }}\n\nLEADS REPLIED (respond today!)\n{{ $json.repliedLeads }}\n\nFOLLOW-UPS DUE\n{{ $json.followUpsDue }}\n\nHOT LEADS NOT BOOKED\n{{ $json.hotLeads }}\n\nOVERDUE INVOICES (total {{ $json.overdueTotal }}, all outstanding {{ $json.outstandingTotal }})\n{{ $json.overdue }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a chief of staff writing a morning brief. Output an HTML email body (h3, ul, li, p, b only; no <html> tag). Sections: 1) Top 3 for today (each with why + first action); 2) Reply to (person, one-line ask, suggested answer in <=15 words); 3) Pipeline; 4) Money; 5) Safe to ignore (one line). Be ruthless: under 300 words, no filler, no greetings."
            }
          ]
        }
      },
