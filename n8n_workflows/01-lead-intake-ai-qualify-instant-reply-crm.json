      "id": "9f99169d-14b9-4bef-8d51-061c5c18821f",
      "name": "Draft Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1680,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Lead').item.json;\nconst ai = $('AI Qualify Lead').item.json.output;\nconst days = { hot: 1, warm: 3, cold: 14 }[ai.tier] ?? 3;\nconst next = new Date(Date.now() + days * 864e5).toISOString().slice(0, 10);\nconst threadId = $json.threadId || ($json.message && $json.message.threadId) || '';\nreturn { json: {\n  email: lead.email, name: lead.name, company: lead.company, website: lead.website, phone: lead.phone,\n  source: lead.source, budget: lead.budget, timeline: lead.timeline, message: lead.message,\n  score: ai.score, tier: ai.tier, intent: ai.intent, summary: ai.company_summary || '',\n  next_step: ai.next_step, stage: 'contacted', touches: 1,\n  last_contacted: new Date().toISOString().slice(0, 10), next_follow_up: next,\n  thread_id: threadId, created_at: lead.receivedAt,\n  notes: [...(ai.fit_reasons || []).map(r => '+ ' + r), ...(ai.risks || []).map(r => '- ' + r)].join('\\n'),\n}};",
        "mode": "runOnceForEachItem"
      },
