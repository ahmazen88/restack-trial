      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"number\"\n    },\n    \"tier\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hot\",\n        \"warm\",\n        \"cold\"\n      ]\n    },\n    \"intent\": {\n      \"type\": \"string\",\n      \"description\": \"What they actually want, one line\"\n    },\n    \"company_summary\": {\n      \"type\": \"string\"\n    },\n    \"fit_reasons\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"risks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"next_step\": {\n      \"type\": \"string\"\n    },\n    \"reply_subject\": {\n      \"type\": \"string\"\n    },\n    \"reply_body\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"tier\",\n    \"intent\",\n    \"reply_subject\",\n    \"reply_body\",\n    \"next_step\"\n  ]\n}"
      },
