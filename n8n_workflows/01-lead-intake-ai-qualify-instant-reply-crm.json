      "id": "67a11dd4-d336-406c-b82f-14fa149970c9",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Accept flat JSON or {body:{...}} and common form-builder field names.\nconst src = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst pick = (...keys) => { for (const k of keys) { if (src[k]) return String(src[k]).trim(); } return ''; };\nconst email = pick('email', 'Email', 'email_address', 'contact_email').toLowerCase();\nif (!email || !email.includes('@')) throw new Error('Lead has no valid email: ' + JSON.stringify(src).slice(0, 300));\nconst freeMail = /@(gmail|yahoo|hotmail|outlook|icloud|aol|proton|protonmail|live|me)\\./i.test(email);\nlet website = pick('website', 'url', 'company_website', 'site');\nif (!website && !freeMail) website = email.split('@')[1];\nif (website && !/^https?:\\/\\//.test(website)) website = 'https://' + website;\nreturn { json: {\n  name: pick('name', 'full_name', 'Name', 'first_name') || email.split('@')[0],\n  email,\n  company: pick('company', 'Company', 'organization', 'business') || (freeMail ? '' : email.split('@')[1].split('.')[0]),\n  website,\n  phone: pick('phone', 'Phone', 'tel'),\n  budget: pick('budget', 'Budget'),\n  timeline: pick('timeline', 'Timeline', 'when'),\n  source: pick('source', 'utm_source', 'Source') || 'webhook',\n  message: pick('message', 'Message', 'notes', 'details', 'comments', 'body'),\n  receivedAt: new Date().toISOString(),\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "6c6820f8-fabb-4dc8-8a9e-ac3d306eb59c",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.website || 'https://example.invalid' }}",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          },
          "timeout": 15000
        }
      },
      "id": "08555a77-472b-4a1c-bb6c-d6cd4e7e26aa",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Turn raw HTML into compact readable text for the model (max ~5k chars).\nconst html = String($json.html || '');\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#39;/g, \"'\").replace(/&quot;/g, '\"')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 5000);\nreturn { json: { websiteText: text || '(website unavailable)' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "d0d543cb-7809-41b3-acac-cf09d6028f77",
      "name": "Website → Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Our business: {{ $('Config').first().json.businessName }}\nWhat we offer / ideal customer: {{ $('Config').first().json.offerSummary }}\nBooking link: {{ $('Config').first().json.bookingLink }}\nSender name for the reply: {{ $('Config').first().json.ownerName }}\n\nNEW LEAD\n{{ JSON.stringify($('Normalize Lead').item.json, null, 2) }}\n\nTHEIR WEBSITE (truncated)\n{{ $json.websiteText }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a senior B2B sales qualifier. Score the lead 0-100 on fit with our offer, budget signal, urgency and authority. tier = hot (>=70), warm (40-69) or cold (<40). Then write the first reply email: warm, specific to their message and company (reference one concrete detail), max 120 words, no fluff, no 'I hope this finds you well'. Hot/warm: propose a short call with the booking link. Cold: helpful, point to a next step without hard selling. Plain text, sign with the sender name. Never invent facts about them."
            }
          ]
        }
      },
