{
  "name": "11 · Customer Email → AI Draft → Your Approval → Send (human-in-the-loop)",
  "nodes": [
    {
      "parameters": {
        "content": "## AI writes, you approve from your phone\nCustomer emails matching `watchQuery` (e.g. to support@, or a label) get a reply drafted from your knowledge base.\n\nYou receive an email with **Approve / Request changes** buttons:\n- Approve → sent as a real reply in the customer's thread\n- Changes → you type what to fix, Claude revises, you get a new approval email (loops until approved, max 4 rounds)\n\nAlso callable by webhook (`/draft-with-approval`) with `{\"from\":\"…\",\"subject\":\"…\",\"body\":\"…\"}` → then it sends a new email instead of a thread reply.",
        "width": 540,
        "height": 380,
        "color": 5
      },
      "id": "6437447f-5ea6-45e9-b824-c7003585d456",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -420
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "to:support@yourcompany.com",
          "readStatus": "unread"
        },
        "options": {}
      },
      "id": "d7f24086-74fa-410e-98e5-436a52d61a47",
      "name": "Customer Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -80
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "draft-with-approval",
        "responseMode": "onReceived",
        "options": {
          "responseData": "Accepted"
        }
      },
      "id": "afcf173e-7adf-45b2-81cb-a4584cd1d018",
      "name": "Draft Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        120
      ],
      "webhookId": "9d15e89a-6834-466b-a78f-f67be9b793ac"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b319e593-da2e-43c4-8a12-6bc75e40c62c",
              "name": "ownerEmail",
              "value": "you@yourcompany.com",
              "type": "string"
            },
            {
              "id": "92b57d06-b697-4317-904d-559f5dd11b6e",
              "name": "ownerName",
              "value": "Your Name",
              "type": "string"
            },
            {
              "id": "9b7d6dd8-d381-4d1c-91fa-3f31252ef85a",
              "name": "businessName",
              "value": "Your Company",
              "type": "string"
            },
            {
              "id": "5308b749-a761-40d9-83c9-571046751991",
              "name": "spreadsheetId",
              "value": "PASTE_GOOGLE_SHEET_ID",
              "type": "string"
            },
            {
              "id": "95cca78f-8110-4e30-aba2-4121c20c18ac",
              "name": "knowledgeBase",
              "value": "Paste FAQs, policies, pricing, refund rules, SLAs, tone of voice here. Or replace this with a Google Docs 'Get' node and reference its content.",
              "type": "string"
            },
            {
              "id": "4466ec63-a953-44c7-93d3-c3d9eb3fba4a",
              "name": "maxRounds",
              "value": 4,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "8ea778eb-84fe-4dd4-a2fb-5b19e2463cf6",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: j }) => {\n  if (j.id && j.threadId) {   // came from Gmail trigger\n    const f = j.from?.value?.[0] || {};\n    return { json: { messageId: j.id, threadId: j.threadId, fromEmail: f.address, fromName: f.name || '',\n      subject: j.subject || '', body: String(j.text || j.snippet || '').split(/\\nOn .{5,80} wrote:/)[0].slice(0, 6000), round: 0 } };\n  }\n  const b = j.body && typeof j.body === 'object' ? j.body : j;\n  return { json: { messageId: '', threadId: '', fromEmail: b.from || b.email, fromName: b.name || '',\n    subject: b.subject || '', body: String(b.body || b.message || ''), round: 0 } };\n});"
      },
      "id": "cf20cb7b-7087-48a9-b71c-00148fd93e7b",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=KNOWLEDGE BASE\n{{ $('Config').first().json.knowledgeBase }}\n\nCUSTOMER: {{ $json.fromName }} <{{ $json.fromEmail }}>\nSUBJECT: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are {{ $('Config').first().json.ownerName }} at {{ $('Config').first().json.businessName }}. Draft a reply that fully resolves the request using ONLY the knowledge base. If something is unknown, say you'll check and get back within one business day instead of guessing. Warm, direct, under 150 words, plain text, sign off with first name. Also give confidence 0-1 and list anything the approver should double-check."
            }
          ]
        }
      },
      "id": "ad081013-988c-47f8-b262-eba53c626225",
      "name": "AI Draft",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "83d17536-8a0c-4635-99b2-2aecc837e808",
      "name": "Claude (AI Draft)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        620,
        220
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"reply\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    },\n    \"check\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"reply\",\n    \"confidence\"\n  ]\n}"
      },
      "id": "5f1325e4-6667-4fd8-93ba-f4b843ae265d",
      "name": "Parser (AI Draft)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        800,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Single place that holds the draft for the approval loop (first draft or a revision).\nconst req = $('Normalize Request').item.json;\nconst round = $runIndex + 1;  // 1 = first draft, 2+ = revisions\nreturn { json: { ...req, reply: $json.output.reply, confidence: $json.output.confidence ?? '', check: ($json.output.check || []).join('; '), round } };",
        "mode": "runOnceForEachItem"
      },
      "id": "38d492e9-22c4-4a84-9073-ce29103d0c6e",
      "name": "Current Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Config').first().json.ownerEmail }}",
        "subject": "=✋ Approve reply to {{ $json.fromName || $json.fromEmail }}: {{ $json.subject }} (v{{ $json.round }})",
        "message": "=CUSTOMER WROTE:\n{{ $json.body.slice(0, 1500) }}\n\n────────── PROPOSED REPLY ──────────\n{{ $json.reply }}\n\nConfidence: {{ $json.confidence }}   Double-check: {{ $json.check || '-' }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "✅ Send it",
            "disapproveLabel": "✏️ Request changes"
          }
        },
        "options": {
          "appendAttribution": false,
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 3,
              "resumeUnit": "days"
            }
          }
        }
      },
      "id": "e64dbfe6-5ac1-4689-8a6d-9b4f11886d4b",
