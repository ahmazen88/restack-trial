              "value": "Your Name",
              "type": "string"
            },
            {
              "id": "b2c5177b-f025-4bdb-884a-0a610f419e51",
              "name": "businessName",
              "value": "Your Company",
              "type": "string"
            },
            {
              "id": "8f837c1d-ee7a-4fc1-b4ba-46e3ba3ba3e9",
              "name": "spreadsheetId",
              "value": "PASTE_GOOGLE_SHEET_ID",
              "type": "string"
