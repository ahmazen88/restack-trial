            {
              "id": "58dae6a0-8ea8-48db-9342-8e223a501e40",
              "name": "offerSummary",
              "value": "What you sell, packages and prices, typical outcomes.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5ec84680-2f82-4a7a-97d1-01d9d28a8778",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst p = b.payload || {};\nlet name = '', email = '', start = '', title = '', notes = '';\nif (b.event && String(b.event).startsWith('invitee')) {            // Calendly\n  name = p.name; email = p.email; start = p.scheduled_event?.start_time; title = p.scheduled_event?.name;\n  notes = (p.questions_and_answers || []).map(q => `${q.question}: ${q.answer}`).join('\\n');\n} else if (b.triggerEvent) {                                        // Cal.com\n  const a = (p.attendees || [])[0] || {};\n  name = a.name; email = a.email; start = p.startTime; title = p.title;\n  notes = [p.description, ...Object.entries(p.responses || {}).map(([k, v]) => `${k}: ${typeof v === 'object' ? (v.value ?? JSON.stringify(v)) : v}`)].filter(Boolean).join('\\n');\n} else {                                                            // plain JSON\n  name = b.name; email = b.email; start = b.start_time || b.startTime; title = b.title || 'Call'; notes = b.notes || '';\n}\nemail = String(email || '').toLowerCase();\nconst freeMail = /@(gmail|yahoo|hotmail|outlook|icloud|aol|proton|protonmail|live|me)\\./i.test(email);\nconst website = b.website || (email && !freeMail ? 'https://' + email.split('@')[1] : '');\nreturn { json: { name, email, start_time: start, title, notes, website, company: b.company || (freeMail ? '' : (email.split('@')[1] || '').split('.')[0]) } };",
        "mode": "runOnceForEachItem"
      },
      "id": "fff64523-27aa-4fdd-b652-353b0c9304db",
      "name": "Normalize Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.website || 'https://example.invalid' }}",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          },
          "timeout": 15000
        }
      },
      "id": "768fc819-1fc2-45f2-8422-2b83ab1e9c99",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Turn raw HTML into compact readable text for the model (max ~5k chars).\nconst html = String($json.html || '');\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#39;/g, \"'\").replace(/&quot;/g, '\"')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 5000);\nreturn { json: { websiteText: text || '(website unavailable)' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "e8c7e989-a8b9-4389-baf3-062fb96db5bd",
      "name": "Website → Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
