    {
      "parameters": {
        "promptType": "define",
        "text": "=Our business: {{ $('Config').first().json.businessName }}. Offer: {{ $('Config').first().json.offerSummary }}\n\nBOOKING\n{{ JSON.stringify($('Normalize Booking').first().json, null, 2) }}\n\nCRM RECORD (may be empty)\n{{ JSON.stringify($json, null, 2) }}\n\nWEBSITE TEXT\n{{ $('Website → Text').first().json.websiteText }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You prepare sales call briefs. Be concrete and skimmable. Only use facts in the input; label guesses as guesses. Return a brief as clean HTML (h3, ul, p, b only)."
            }
          ]
        }
      },
