      "id": "4d0e1d53-9a56-4f3c-b089-e02f85d76823",
      "name": "Mark Replied",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1560,
        -140
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Business: {{ $('Config').first().json.businessName }} — {{ $('Config').first().json.offerSummary }}\nSender: {{ $('Config').first().json.ownerName }}\nBooking link: {{ $('Config').first().json.bookingLink }}\nThis is follow-up touch #{{ Number($json.touches || 0) + 1 }} of max {{ $('Config').first().json.maxTouches }}.\n\nLEAD RECORD\n{{ JSON.stringify($json, null, 2) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Write a short follow-up email (50-90 words, plain text). Angle by touch number: 2 = add value (an insight or quick idea specific to their situation); 3 = social proof / a relevant result with a soft call to action; 4+ = polite break-up ('should I close your file?'), which gets the most replies. Do not repeat earlier wording, never guilt-trip, one clear question at the end. Subject: short, lowercase-friendly, may start with 'Re: ' to keep the thread feel."
            }
          ]
        }
      },
