      "id": "89e21c99-a146-47be-a793-3bd2fc3dd62d",
      "name": "Send Follow-Up",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1880,
        120
      ],
      "webhookId": "23338298-1661-41b1-a3eb-4ee6df31bb17"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst r = $('Split Replied / Pending').item.json;\nconst touches = Number(r.touches || 0) + 1;\nconst cadence = String(cfg.cadenceDays).split(',').map(Number);\nconst gap = cadence[Math.min(touches - 1, cadence.length - 1)] || 7;\nconst done = touches >= Number(cfg.maxTouches);\nreturn { json: {\n  email: r.email, touches,\n  last_contacted: new Date().toISOString().slice(0, 10),\n  next_follow_up: done ? '' : new Date(Date.now() + gap * 864e5).toISOString().slice(0, 10),\n  stage: done ? 'nurture' : (r.stage || 'contacted'),\n}};",
        "mode": "runOnceForEachItem"
      },
