      "id": "1446ee65-63e7-4db2-93ed-fe1109aeca5f",
      "name": "Read Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst today = new Date().toISOString().slice(0, 10);\nconst open = ['new', 'contacted', 'proposal_sent', 'meeting_booked_no_show'];\nconst due = $input.all().map(i => i.json).filter(r =>\n  r.email && open.includes(String(r.stage || 'new')) &&\n  String(r.next_follow_up || '') !== '' && String(r.next_follow_up).slice(0, 10) <= today &&\n  Number(r.touches || 0) < Number(cfg.maxTouches));\nreturn due.map(r => ({ json: r }));"
      },
      "id": "04d87894-0009-43c3-afa4-cb6c1042423d",
      "name": "Select Due Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": true,
        "simple": false,
        "filters": {
          "q": "=newer_than:30d -in:sent from:({{ $('Select Due Leads').all().map(i => i.json.email).join(' OR ') }})"
        },
        "options": {}
      },
      "id": "8af619c6-90aa-4e7a-b3b1-9b1186bf1753",
      "name": "Check For Replies",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Anyone who emailed us after our last touch has replied → stop the sequence for them.\nconst lastByEmail = {};\nfor (const m of $('Check For Replies').all()) {\n  const from = m.json.from?.value?.[0]?.address?.toLowerCase();\n  if (!from) continue;\n  const d = new Date(m.json.date || 0).toISOString().slice(0, 10);\n  if (!lastByEmail[from] || d > lastByEmail[from]) lastByEmail[from] = d;\n}\nreturn $('Select Due Leads').all().map(i => {\n  const r = i.json; const got = lastByEmail[String(r.email).toLowerCase()];\n  return { json: { ...r, replied: !!got && got >= String(r.last_contacted || '').slice(0, 10) } };\n});"
      },
      "id": "97abeca4-1dfb-4a85-b290-5836d7408292",
      "name": "Split Replied / Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
