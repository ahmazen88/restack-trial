      "name": "Claude (AI Classify)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1040,
        220
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"lead\",\n        \"client\",\n        \"billing\",\n        \"support\",\n        \"scheduling\",\n        \"vendor\",\n        \"newsletter\",\n        \"notification\",\n        \"personal\",\n        \"spam\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"high\",\n        \"normal\",\n        \"low\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"<= 20 words\"\n    },\n    \"needs_reply\": {\n      \"type\": \"boolean\"\n    },\n    \"reply\": {\n      \"type\": \"string\"\n    },\n    \"deadline\": {\n      \"type\": \"string\",\n      \"description\": \"ISO date if one is mentioned, else empty\"\n    },\n    \"amount\": {\n      \"type\": \"string\",\n      \"description\": \"money amount if mentioned, else empty\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"urgency\",\n    \"summary\",\n    \"needs_reply\"\n  ]\n}"
      },
      "id": "0e9d6d8f-6e58-4423-bf97-9eb97da07164",
      "name": "Parser (AI Classify)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1220,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst e = $('Add CRM Context').item.json;\nconst ai = $json.output;\nconst map = { lead: cfg.label_lead, client: cfg.label_client, billing: cfg.label_billing, support: cfg.label_support,\n  scheduling: cfg.label_scheduling, newsletter: cfg.label_fyi, notification: cfg.label_fyi, vendor: cfg.label_fyi };\nconst labelIds = [map[ai.category], ai.needs_reply ? cfg.label_needs_reply : null].filter(l => l && !/_ID$/.test(l));\nreturn { json: { ...e, ...ai, reply: ai.reply || '', labelIds,\n  isNewLead: ai.category === 'lead' && !e.knownLead,\n  knownLeadReplied: e.knownLead,\n  autoArchive: ['newsletter', 'notification', 'spam'].includes(ai.category) && ai.urgency !== 'high',\n  urgent: ai.urgency === 'high',\n}};",
        "mode": "runOnceForEachItem"
      },
