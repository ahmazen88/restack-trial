    {
      "parameters": {
        "jsCode": "// Flatten a Gmail message (simple=false) into what the model needs.\nconst m = $('New Email').item.json;\nconst from = m.from?.value?.[0] || {};\nconst body = String(m.text || m.textAsHtml || m.snippet || '').replace(/\\n{3,}/g, '\\n\\n');\n// Drop quoted history so we classify the new part only\nconst fresh = body.split(/\\n(?:On .{5,80} wrote:|-{2,} ?Original Message|From: .+\\nSent: )/)[0];\nreturn { json: {\n  messageId: m.id, threadId: m.threadId,\n  fromEmail: String(from.address || '').toLowerCase(), fromName: from.name || '',\n  to: m.to?.text || '', subject: m.subject || '(no subject)', date: m.date,\n  body: fresh.slice(0, 6000),\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "70bb4243-f291-4568-9233-8ca0f507b136",
      "name": "Prep Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
