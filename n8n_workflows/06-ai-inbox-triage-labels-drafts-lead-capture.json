      "id": "0a986fc0-1193-4009-aa5e-1320ca709ef4",
      "name": "Read Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// One sheet read for the whole batch, then match each email's sender against it.\nconst leads = {};\nfor (const { json: l } of $('Read Leads').all()) if (l.email) leads[String(l.email).toLowerCase()] = l;\nreturn $('Prep Email').all().map(({ json: e }) => {\n  const l = leads[e.fromEmail];\n  return { json: { ...e, knownLead: !!l, leadStage: l?.stage || '', leadSummary: l?.intent || '' } };\n});"
      },
      "id": "9b8e5ef9-1469-48fd-b00a-413ddeba180f",
      "name": "Add CRM Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=About me / my business: {{ $('Config').first().json.aboutMe }}\n\nSender is {{ $json.knownLead ? 'an EXISTING lead in my CRM (stage: ' + $json.leadStage + ')' : 'not in my CRM' }}.\n\nFROM: {{ $json.fromName }} <{{ $json.fromEmail }}>\nSUBJECT: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You triage a busy founder's inbox. Categories: lead (new potential customer asking about buying), client (existing customer about ongoing work), billing (invoices, payments, receipts), support (problem/help request), scheduling (meeting times), vendor (sales pitches, partnerships, cold outreach TO us), newsletter, notification (automated), personal, spam. urgency high only if money, a deadline within 48h, an angry client, or legal. needs_reply = a human is waiting for an answer from us. If needs_reply, write the reply in my voice using only facts from 'About me'; where info is missing write [[placeholder]]. Keep replies under 120 words, plain text, no signature."
            }
          ]
        }
      },
