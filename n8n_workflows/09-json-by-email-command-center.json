              "type": "string"
            },
            {
              "id": "d0b180d2-f969-41d6-a737-81063728a7a9",
              "name": "allowedSenders",
              "value": "you@yourcompany.com,assistant@yourcompany.com",
              "type": "string"
            },
            {
              "id": "ce1d267c-47a2-4d37-aa54-ad871946072e",
              "name": "token",
              "value": "CHANGE-ME-long-random-string",
              "type": "string"
            },
            {
              "id": "50357eb0-5085-47b9-b6a6-fac072aa8424",
              "name": "routes",
              "value": "{\n \"add_lead\": \"https://YOUR-N8N/webhook/lead-intake\",\n \"meeting_brief\": \"https://YOUR-N8N/webhook/meeting-booked\",\n \"project_complete\": \"https://YOUR-N8N/webhook/project-complete\",\n \"research\": \"https://YOUR-N8N/webhook/research\",\n \"approve_reply\": \"https://YOUR-N8N/webhook/draft-with-approval\"\n}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "76fa8013-6e34-42c0-8314-41735d1b83ff",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst allowed = String(cfg.allowedSenders).toLowerCase().split(',').map(s => s.trim());\nconst routes = JSON.parse(cfg.routes);\nconst handle = (m) => {\nconst from = String(m.from?.value?.[0]?.address || '').toLowerCase();\nconst base = { messageId: m.id, from };\nif (!allowed.includes(from)) return [{ json: { ...base, ok: false, notify: false, error: 'sender not allowed' } }];\n// Pull the first {...} or [...] block out of the body (handles ```json fences and signatures)\nconst raw = String(m.text || '').replace(/```(?:json)?/g, '');\nconst start = raw.search(/[\\{\\[]/);\nlet cmd;\ntry {\n  if (start < 0) throw new Error('no JSON found');\n  let depth = 0, end = -1, inStr = false, esc = false;\n  for (let i = start; i < raw.length; i++) {\n    const c = raw[i];\n    if (inStr) { if (esc) esc = false; else if (c === '\\\\') esc = true; else if (c === '\"') inStr = false; continue; }\n    if (c === '\"') inStr = true; else if (c === '{' || c === '[') depth++; else if (c === '}' || c === ']') { depth--; if (depth === 0) { end = i; break; } }\n  }\n  cmd = JSON.parse(raw.slice(start, end + 1).replace(/[“”]/g, '\"').replace(/[‘’]/g, \"'\"));\n} catch (e) {\n  return [{ json: { ...base, ok: false, notify: true, error: 'Invalid JSON: ' + e.message } }];\n}\nconst cmds = Array.isArray(cmd) ? cmd : [cmd];\nconst out = [];\nfor (const c of cmds) {\n  if (c.token !== cfg.token && cmd.token !== cfg.token) { out.push({ json: { ...base, ok: false, notify: false, error: 'bad token' } }); continue; }\n  const url = routes[c.action];\n  if (!url) { out.push({ json: { ...base, ok: false, notify: true, error: `Unknown action \"${c.action}\". Known: ${Object.keys(routes).join(', ')}` } }); continue; }\n  for (const d of (Array.isArray(c.data) ? c.data : [c.data || {}])) out.push({ json: { ...base, ok: true, action: c.action, url, payload: d } });\n}\nreturn out;\n};\nreturn $('Command Email').all().flatMap(i => handle(i.json));"
      },
