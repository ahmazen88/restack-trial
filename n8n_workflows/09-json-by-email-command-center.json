      "id": "45d50d32-5dc5-4fcb-a347-675d4613dce8",
      "name": "Call Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const runs = $('Valid?').all().filter(i => i.json.ok);\nconst lines = $input.all().map((r, idx) => {\n  const src = runs[idx]?.json || {};\n  const ok = !r.json.error;\n  return `${ok ? '✅' : '❌'} ${src.action} ${JSON.stringify(src.payload).slice(0, 120)}${ok ? '' : ' → ' + (r.json.error?.message || JSON.stringify(r.json.error))}`;\n});\nreturn [{ json: { messageId: runs[0]?.json.messageId, body: `Ran ${lines.length} command(s):\\n\\n${lines.join('\\n')}` } }];"
      },
