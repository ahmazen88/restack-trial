        "sendTo": "={{ $('Config').first().json.ownerEmail }}",
        "subject": "=⚠️ {{ $('Read Answer').item.json.rating }}★ from {{ $('Read Answer').item.json.client_name }} ({{ $('AI Recovery Draft').item.json.output.severity }})",
        "emailType": "text",
        "message": "=Project: {{ $('Read Answer').item.json.project }}\nComment: {{ $('Read Answer').item.json.comment }}\n\nLikely cause: {{ $('AI Recovery Draft').item.json.output.root_cause }}\n\nA reply is waiting in your Gmail drafts.",
        "options": {
          "appendAttribution": false
        }
      },
