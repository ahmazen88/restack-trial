    {
      "parameters": {
        "sendTo": "={{ $json.client_email }}",
        "subject": "=Thank you, {{ $json.first_name }} 🙏",
        "emailType": "text",
        "message": "=Hi {{ $json.first_name }},\n\nThat made our day — thank you.\n\nWould you be up for sharing that in a public review? It takes a minute and helps other people find us:\n{{ $('Config').first().json.reviewLink }}\n\n{{ $('Config').first().json.referralOffer }}\n\n{{ $('Config').first().json.ownerName }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "07965c17-2b1d-47e3-a27c-a4030a4bea45",
      "name": "Thank + Review Ask",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1380,
        -180
      ],
      "webhookId": "415b4d1c-772c-45d9-a3b2-9edc11b815d6"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Client: {{ $json.client_name }}\nProject: {{ $json.project }}\nRating: {{ $json.rating }}/5\nComment: {{ $json.comment || '(none)' }}\nSender: {{ $('Config').first().json.ownerName }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "A client gave low feedback. Diagnose the likely root cause in one line, then write a sincere, non-defensive reply (<120 words) that thanks them, owns what is ours, asks one specific question and offers a short call. No discounts unless the comment is about price."
            }
          ]
        }
      },
