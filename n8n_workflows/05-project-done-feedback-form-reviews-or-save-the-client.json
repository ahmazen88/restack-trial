    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"root_cause\": {\n      \"type\": \"string\"\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"reply\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"root_cause\",\n    \"severity\",\n    \"reply\"\n  ]\n}"
      },
      "id": "ad7e53c4-69d2-4d0a-bbe0-bc252555ab66",
      "name": "Parser (AI Recovery Draft)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
