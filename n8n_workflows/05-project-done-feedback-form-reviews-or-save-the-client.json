      "id": "c81094be-f2de-489e-8d54-47fa734dc615",
      "name": "Client",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $json.client_email }}",
        "subject": "=Quick question about {{ $json.project }}",
        "message": "=Hi {{ $json.first_name }},\n\nThanks again for trusting {{ $('Config').first().json.businessName }} with {{ $json.project }}. Could you spare 20 seconds to tell us how it went? It genuinely shapes how we work.\n\n{{ $('Config').first().json.ownerName }}",
        "responseType": "customForm",
        "formFields": {
          "values": [
            {
              "fieldLabel": "rating",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "5 - Excellent"
                  },
                  {
                    "option": "4 - Good"
                  },
                  {
                    "option": "3 - Okay"
                  },
                  {
                    "option": "2 - Poor"
                  },
                  {
                    "option": "1 - Bad"
                  }
                ]
              }
            },
            {
              "fieldLabel": "comment",
              "fieldType": "textarea",
              "placeholder": "What went well? What could be better?"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "responseFormTitle": "How did we do?",
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 14,
              "resumeUnit": "days"
            }
          }
        }
      },
      "id": "cea934a8-2d52-403f-9026-6990f42f1cd7",
      "name": "Ask For Feedback",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "webhookId": "cc18638a-a6cb-4871-8b7b-25eb1b59bcb4"
    },
    {
      "parameters": {
        "jsCode": "const c = $('Client').item.json;\nconst d = $json.data || {};\nconst rating = parseInt(String(d.rating || '').slice(0, 1), 10) || null;\nreturn { json: { ...c, rating, comment: d.comment || '', responded: rating !== null, at: new Date().toISOString() } };",
        "mode": "runOnceForEachItem"
      },
