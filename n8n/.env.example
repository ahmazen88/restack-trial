# Copy to .env or export before ./start.sh
# Do not commit real passwords.

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false

# Local owner only (not an n8n Cloud account)
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=local@n8n.local
N8N_INSTANCE_OWNER_FIRST_NAME=Local
N8N_INSTANCE_OWNER_LAST_NAME=Owner
# bcrypt hash of the password (not plaintext)
# N8N_INSTANCE_OWNER_PASSWORD_HASH=
